<apex:page controller="BusinessLicencePreviewController" showHeader="false" sidebar="false" standardStylesheets="false">
<style>
  html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; background: #f3f3f3; }
  embed, iframe { display: block; width: 100%; height: 100%; min-height: 560px; border: none; }
  .centre { display: flex; align-items: center; justify-content: center; height: 100%; min-height: 200px; color: #706e6b; font-family: 'Salesforce Sans', sans-serif; font-size: 13px; }
</style>
<apex:outputPanel rendered="{!isPdf}">
    <embed src="data:application/pdf;base64,{!pdfBase64}" type="application/pdf" />
</apex:outputPanel>
<apex:outputPanel rendered="{!isWordDoc}">
    <iframe src="{!renditionUrl}" />
</apex:outputPanel>
<apex:outputPanel rendered="{!NOT(OR(isPdf, isWordDoc))}">
    <div class="centre">No document attached.</div>
</apex:outputPanel>
</apex:page>